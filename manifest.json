{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.0",
  "default_locale": "ru",
  "description": "__MSG_extDescription__",
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": [
    "https://www.cbr-xml-daily.ru/*",
    "https://open.er-api.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Цены в рублях",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*/*.pdf"],
      "js": ["lib/parser.js", "lib/config.js", "lib/i18n.js", "content/converter.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
